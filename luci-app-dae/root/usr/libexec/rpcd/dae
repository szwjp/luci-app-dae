#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# rpcd backend of the dae LuCI page.
#
# The panel is served by dae itself, so this backend does not proxy it: it
# reports the state of the service and the address the panel lives at, and it
# starts, stops and reconfigures the daemon. The LuCI page reads the result
# over ubus, exactly like the honk package does for its own core.

. /lib/functions.sh
. /lib/functions/network.sh
. /usr/share/libubox/jshn.sh

CONFIG=dae
UI_PATH=/usr/share/dae/doona
DEFAULT_LISTEN=0.0.0.0:9527
LAN_NETWORK=lan

emit_result() {
	ok=$1
	message=$2
	[ "$ok" = true ] && ok=1 || ok=0
	json_init
	json_add_boolean ok "$ok"
	json_add_string message "$message"
	json_dump
}

# The listener address has to be a numeric address with a port, the same rule
# the init script applies before it starts the daemon.
valid_listen() {
	local listen="$1" host port

	host="${listen%:*}"
	port="${listen##*:}"
	[ "$host" != "$listen" ] || return 1
	case "$port" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1

	case "$host" in
		\[*\]*)
			host="${host#\[}"
			host="${host%\]}"
			;;
	esac

	case "$host" in
		'') return 1 ;;
		*:*)
			case "$host" in *[!0-9a-fA-F:]*) return 1 ;; esac
			;;
		*)
			case "$host" in *[!0-9.]*) return 1 ;; esac
			;;
	esac

	return 0
}

listen_port() {
	echo "${1##*:}"
}

listen_host() {
	local host="${1%:*}"
	case "$host" in
		\[*\]*)
			host="${host#\[}"
			host="${host%\]}"
			;;
	esac
	echo "$host"
}

is_loopback() {
	case "$1" in
		127.*|::1|0:0:0:0:0:0:0:1) return 0 ;;
	esac
	return 1
}

service_running() {
	case "$(/etc/init.d/dae status 2>/dev/null)" in
		running*) return 0 ;;
	esac
	return 1
}

# The pid procd has for the instance, or empty when no instance runs. Reading
# the pid instead of the status words is what makes the wait below reliable: a
# restart that leaves the old process in place for a moment still reports the
# old pid, so a check that only asks "is it running" answers for the process
# that is about to be replaced.
service_pid() {
	local pid

	pid="$(ubus call service list '{"name":"dae"}' 2>/dev/null |
		jsonfilter -e '@.dae.instances.dae.pid' 2>/dev/null)"
	case "$pid" in
		''|*[!0-9]*)
			echo ""
			;;
		*)
			echo "$pid"
			;;
	esac
}

# procd stops and starts the instance asynchronously: the daemon needs a
# moment to exit, and the state right after the command still reports the
# old one. A stop that reported a failure although the daemon was on its
# way out would be a lie, so the state is waited for, with a bound.
wait_state() {
	local want="$1" tries="$2" i=0

	while [ "$i" -lt "$tries" ]; do
		if [ "$want" = running ]; then
			service_running && return 0
		else
			service_running || return 0
		fi
		i=$((i + 1))
		[ "$i" -lt "$tries" ] && sleep 1
	done

	return 1
}

# Waits until the instance runs under a pid other than the one it had before
# the restart. A failed start leaves the old pid gone and no new one, and a
# start that dies at once leaves no pid either, so both are reported as a
# failure instead of as a success that the next status call contradicts.
wait_new_instance() {
	local before="$1" tries="$2" i=0 pid

	while [ "$i" -lt "$tries" ]; do
		pid="$(service_pid)"
		if [ -n "$pid" ] && [ "$pid" != "$before" ]; then
			return 0
		fi
		i=$((i + 1))
		[ "$i" -lt "$tries" ] && sleep 1
	done

	return 1
}

boot_enabled() {
	/etc/init.d/dae enabled >/dev/null 2>&1
}

# Every IPv4 address the daemon may be reached at, most useful first.
#
# The API answers a wildcard bind only for an IP literal in the Host header, so
# a page opened by name cannot build the address from the browser's own host.
# The old code guessed with the LAN address, which is wrong on a router that
# carries more than one network: this one has the LAN at 192.168.2.1 and the
# uplink at 192.168.1.140, and a browser in 192.168.1.0/24 cannot reach
# 192.168.2.1 at all.
#
# The addresses are listed instead, with the one of the LAN first, and the page
# picks the candidate it can actually reach. A hundred entries are not needed:
# the first few live addresses cover every setup a router has.
listen_addresses() {
	local lan_device device address found=" " count=0

	# The LAN address first: it is the one a client of this router uses.
	lan_device="$(network_get_device device "$LAN_NETWORK" 2>/dev/null && echo "$device")"
	if [ -n "$lan_device" ]; then
		address="$(network_get_ipaddr address "$LAN_NETWORK" 2>/dev/null && echo "$address")"
		case "$address" in
			''|*[!0-9.]*) address= ;;
		esac
		if [ -n "$address" ]; then
			printf '%s ' "$address"
			found="$found$address "
			count=$((count + 1))
		fi
	fi

	# Then everything else that is up and carries an IPv4 address.
	for device in /sys/class/net/*; do
		[ -e "$device" ] || continue
		device="$(basename "$device")"
		[ "$device" = "lo" ] && continue
		[ "$(cat "/sys/class/net/$device/operstate" 2>/dev/null)" = "up" ] || continue

		address="$(ip -4 -o addr show dev "$device" 2>/dev/null |
			awk '$3 == "inet" { sub(/\/.*/, "", $4); print $4; exit }')"
		case "$address" in
			''|*[!0-9.]*) continue ;;
		esac

		# No address twice, whatever path found it first.
		case "$found" in
			*" $address "*) continue ;;
		esac

		printf '%s ' "$address"
		found="$found$address "
		count=$((count + 1))
		[ "$count" -ge 8 ] && break
	done

	printf '\n'
}

status() {
	local enabled listen port api_write secret ui_path panel_available running boot errors lan addresses

	config_load "$CONFIG"
	config_get_bool enabled main enabled 0
	config_get listen main api_listen "$DEFAULT_LISTEN"
	config_get api_write main api_write "0"
	config_get secret main api_secret ""
	config_get ui_path main ui_path "$UI_PATH"

	port="$(listen_port "$listen")"
	case "$port" in
		''|*[!0-9]*) port=0 ;;
	esac

	if service_running; then running=1; else running=0; fi
	if boot_enabled; then boot=1; else boot=0; fi
	if [ -r "$ui_path/index.html" ]; then panel_available=1; else panel_available=0; fi
	[ "$api_write" = "1" ] && api_write=1 || api_write=0
	addresses="$(listen_addresses)"
	# lan_address stays for the pages of an older package that only know that
	# one field; the candidate list below is what the current page uses.
	lan="${addresses%% *}"

	errors=""
	[ "$enabled" = 1 ] || errors="$errors disabled"
	if [ "$enabled" = 1 ] && [ "$running" != 1 ]; then
		errors="$errors service_not_running"
	fi
	[ -n "$secret" ] || errors="$errors secret_missing"
	[ "$panel_available" = 1 ] || errors="$errors panel_missing"
	if valid_listen "$listen"; then
		if is_loopback "$(listen_host "$listen")"; then
			errors="$errors loopback_listener"
		fi
	else
		errors="$errors invalid_listener"
	fi

	json_init
	json_add_boolean enabled "$enabled"
	json_add_boolean running "$running"
	json_add_boolean boot_enabled "$boot"
	json_add_string listen "$listen"
	json_add_int port "$port"
	json_add_boolean api_write "$api_write"
	json_add_boolean panel_available "$panel_available"
	json_add_string ui_path "$ui_path"
	json_add_string lan_address "$lan"
	json_add_array lan_addresses
	for lan in $addresses; do
		json_add_string "" "$lan"
	done
	json_close_array
	json_add_array errors
	for error in $errors; do
		json_add_string "" "$error"
	done
	json_close_array
	json_dump
}

secret() {
	local secret

	config_load "$CONFIG"
	config_get secret main api_secret ""

	json_init
	json_add_string secret "$secret"
	json_dump
}

# enabled=1 is persisted before the daemon is started: the init script refuses
# to start a disabled service, and a start that is not saved would come back
# disabled after a reboot. A write that fails ends the operation, because the
# service would run in a state the next boot does not honour.
set_enabled() {
	uci -q set "$CONFIG.main.enabled=1" || return 1
	uci -q commit "$CONFIG" || return 1
	return 0
}

# rc.common always reports a started procd service as started, so the state is
# read back instead of trusting the exit code of the init script.
start() {
	if ! set_enabled; then
		emit_result false settings_write_failed
		return 1
	fi
	/etc/init.d/dae start >/dev/null 2>&1
	if wait_new_instance "" 15; then
		emit_result true started
	else
		emit_result false start_failed
	fi
}

stop() {
	/etc/init.d/dae stop >/dev/null 2>&1
	if wait_state stopped 15; then
		emit_result true stopped
	else
		emit_result false stop_failed
	fi
}

restart() {
	local pid

	if ! set_enabled; then
		emit_result false settings_write_failed
		return 1
	fi
	# The pid the instance had before is what makes the wait below mean
	# something: a restart that keeps the old process alive for a moment,
	# or a new process that dies at once, both fail the comparison.
	pid="$(service_pid)"
	/etc/init.d/dae restart >/dev/null 2>&1
	if wait_new_instance "$pid" 15; then
		emit_result true restarted
	else
		emit_result false restart_failed
	fi
}

enable() {
	if ! set_enabled; then
		emit_result false settings_write_failed
		return 1
	fi
	/etc/init.d/dae enable >/dev/null 2>&1
	/etc/init.d/dae start >/dev/null 2>&1

	# The switch on the LuCI page is the "start at boot" switch, so the
	# result reports the autostart state. Whether the daemon comes up is a
	# separate fact, and the status call reports it: the two must not be
	# mixed up, or a daemon that fails to start hides the autostart change.
	if boot_enabled; then
		emit_result true enabled
	else
		emit_result false enable_failed
	fi
}

disable() {
	/etc/init.d/dae disable >/dev/null 2>&1

	if boot_enabled; then
		emit_result false enable_failed
	else
		emit_result true disabled_action
	fi
}

# The listener address is a UCI value, so the page can change it without the
# configuration files being edited by hand. The daemon reads the value when
# it starts, so a running service is restarted to make the new address take
# effect; a service that is not running picks it up at the next start.
set_listen() {
	local request address port listen previous pid

	request="$(cat)"
	json_load "$request" 2>/dev/null || { emit_result false invalid_request; return 1; }
	json_get_var address address
	json_get_var port port

	# An IPv6 literal carries colons of its own, so it is bracketed before it
	# is joined with the port.
	case "$address" in
		''|*[!0-9a-fA-F:.]*) emit_result false listener_invalid; return 1 ;;
		*:*)
			case "$address" in
				\[*\]*) ;;
				*) address="[$address]" ;;
			esac
			;;
	esac

	listen="$address:$port"
	if ! valid_listen "$listen"; then
		emit_result false listener_invalid
		return 1
	fi

	config_load "$CONFIG"
	config_get previous main api_listen "$DEFAULT_LISTEN"

	if ! uci -q set "$CONFIG.main.api_listen=$listen"; then
		emit_result false settings_write_failed
		return 1
	fi
	if ! uci -q commit "$CONFIG"; then
		uci -q set "$CONFIG.main.api_listen=$previous"
		uci -q commit "$CONFIG"
		emit_result false settings_write_failed
		return 1
	fi

	if service_running; then
		# procd stops and starts asynchronously, so "is it running" is still
		# true for the old instance right after the restart. The pid is what
		# tells the new instance apart from the one that was just stopped.
		pid="$(service_pid)"
		/etc/init.d/dae restart >/dev/null 2>&1
		if wait_new_instance "$pid" 15; then
			emit_result true listener_applied
			return 0
		fi
		# The address was saved but the daemon does not come up with it, so
		# the value is put back: a saved address the daemon rejects leaves
		# the service down until somebody edits UCI by hand.
		uci -q set "$CONFIG.main.api_listen=$previous"
		uci -q commit "$CONFIG"
		pid="$(service_pid)"
		/etc/init.d/dae restart >/dev/null 2>&1
		wait_new_instance "$pid" 15
		emit_result false listener_reverted
	else
		emit_result true listener_saved
	fi
}

# The panel may only write the configuration files when it is allowed to, and
# the daemon reports that in the capabilities of its native API. The switch on
# the LuCI page turns the permission on and off.
set_api_write() {
	local request value previous pid

	request="$(cat)"
	json_load "$request" 2>/dev/null || { emit_result false invalid_request; return 1; }
	json_get_var value value

	case "$value" in
		1|true) value=1 ;;
		0|false) value=0 ;;
		*) emit_result false invalid_value; return 1 ;;
	esac

	# The value to put back when the daemon refuses to start has to be read
	# before the write below: after "uci commit" it is already the new value.
	config_load "$CONFIG"
	config_get previous main api_write "0"

	if ! uci -q set "$CONFIG.main.api_write=$value"; then
		emit_result false settings_write_failed
		return 1
	fi
	if ! uci -q commit "$CONFIG"; then
		emit_result false settings_write_failed
		return 1
	fi

	# The daemon reads the permission when it starts, so it has to be
	# restarted for the change to reach the core.
	if service_running; then
		# The old instance still reports "running" for a moment after the
		# restart, so the wait compares pids instead of the status word.
		pid="$(service_pid)"
		/etc/init.d/dae restart >/dev/null 2>&1
		if wait_new_instance "$pid" 15; then
			emit_result true api_write_applied
			return 0
		fi
		# The permission is written but the daemon does not come back, so
		# the value goes back and the service is restored: an api file the
		# daemon refuses to start with leaves it down.
		uci -q set "$CONFIG.main.api_write=${previous:-0}"
		uci -q commit "$CONFIG"
		pid="$(service_pid)"
		/etc/init.d/dae restart >/dev/null 2>&1
		wait_new_instance "$pid" 15
		emit_result false api_write_reverted
	else
		emit_result true api_write_saved
	fi
}

# rpcd runs an exec backend in a fixed protocol: it asks the script for its
# methods with the "list" argument and reaches a method with
# "call <method>". A script that dispatches on the first argument directly
# gets registered as an object without a single method, and every call from
# the LuCI page fails with "method not found".
case "$1" in
list)
	echo '{"status":{},"secret":{},"start":{},"stop":{},"restart":{},"enable":{},"disable":{},"set_listen":{"address":"String","port":"Integer"},"set_api_write":{"value":"Boolean"}}'
	;;
call)
	case "$2" in
		status) status ;;
		secret) secret ;;
		start) start ;;
		stop) stop ;;
		restart) restart ;;
		enable) enable ;;
		disable) disable ;;
		set_listen) set_listen ;;
		set_api_write) set_api_write ;;
		*) emit_result false invalid_operation ;;
	esac
	;;
*)
	exit 2
	;;
esac
