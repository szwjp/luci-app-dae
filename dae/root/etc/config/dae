config dae 'main'
	option enabled '0'
	option config_file '/etc/dae/config.dae'
	option api_listen '0.0.0.0:9527'
	option api_secret ''
	option api_write '0'
	# The LAN interface dae attaches to. Empty means the interface is taken
	# from the dae configuration file (config.d/global.dae).
	option lan_interface ''
