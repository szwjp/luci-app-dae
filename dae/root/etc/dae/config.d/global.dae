global {
  # The interface the LAN clients are on. br-lan is the OpenWrt default; a
  # device that names its bridge differently needs this changed.
  lan_interface: br-lan
  # The interface the outbound traffic leaves through. "auto" lets dae resolve
  # it from the default route, so the setting fits a router with any number
  # of ports. A single-port device, whose only port is the LAN port, has no
  # WAN interface at all: leave this empty there.
  wan_interface: auto
  log_level: info
  dial_mode: domain
  sniffing_timeout: 30ms
}
