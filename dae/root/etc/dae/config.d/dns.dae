dns {
  upstream {
    alidns: 'udp://dns.alidns.com:53'
    googledns: 'tcp+udp://dns.google:53'
  }
  # The panel creates the first DNS rule inside this block. Without it there is
  # nowhere to insert one and the DNS rule page can only list rules. dae accepts
  # the empty block, and a rule added here becomes request { ... }.
  routing {
  }
}
